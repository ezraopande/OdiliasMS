<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="550.0" prefWidth="500.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.odilias.odms.controller.AddStaffController">
   <children>
      <Label text="Register New Staff Member" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <GridPane hgap="15.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Username *" />
                  <TextField fx:id="usernameField" promptText="e.g. jdoe" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.columnIndex="1">
               <children>
                  <Label text="Password *" />
                  <PasswordField fx:id="passwordField" promptText="Enter initial password" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
               <children>
                  <Label text="Full Name *" />
                  <TextField fx:id="fullNameField" promptText="Enter staff legal name" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.rowIndex="2">
               <children>
                  <Label text="System Role *" />
                  <ComboBox fx:id="roleComboBox" prefWidth="250.0" promptText="Select role" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Label text="Status *" />
                  <ComboBox fx:id="statusComboBox" prefWidth="250.0" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="3">
               <children>
                  <Label text="Email Address" />
                  <TextField fx:id="emailField" promptText="e.g. staff@odilias.com" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="4">
               <children>
                  <Label text="Contact Number" />
                  <TextField fx:id="contactField" promptText="e.g. +254..." />
               </children>
            </VBox>
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Save Staff Account" />
         </children>
      </HBox>
      <Label fx:id="infoLabel" textFill="#e74c3c" />
   </children>
</VBox>
