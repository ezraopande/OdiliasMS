<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: transparent;" styleClass="main-content-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.odilias.odms.controller.MedicalRecordController">
   <children>
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefWidth="300.0" styleClass="card">
               <children>
                  <Label text="Search Patient" textFill="#2f3640">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <TextField fx:id="patientSearchField" onKeyReleased="#handlePatientSearch" prefHeight="40.0" promptText="Enter name or ID..." />
                  <ListView fx:id="patientListView" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="card">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Consultation History" textFill="#2f3640">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="newRecordButton" disable="true" mnemonicParsing="false" onAction="#showAddRecordForm" styleClass="btn-primary" text="+ New Clinical Entry" />
                     </children>
                  </HBox>
                  <TableView fx:id="recordsTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />
                      <TableColumn fx:id="clinicianColumn" prefWidth="150.0" text="Clinician" />
                        <TableColumn fx:id="diagnosisColumn" prefWidth="250.0" text="Diagnosis" />
                    </columns>
                  </TableView>
                  <VBox fx:id="recordDetailsBox" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" visible="false" managed="false" VBox.vgrow="SOMETIMES">
                     <children>
                        <Label text="Full Record Details" textFill="#2980b9">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Separator />
                        <GridPane hgap="15.0" vgap="10.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <Label fx:id="detVitalsLabel" text="Vitals: " GridPane.columnSpan="2" />
                              <Label text="Diagnosis:" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                              <Label fx:id="detDiagnosisLabel" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              
                              <Label text="Treatment Plan:" GridPane.rowIndex="2" style="-fx-font-weight: bold;" />
                              <Label fx:id="detTreatmentLabel" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              
                              <Label text="Prescriptions &amp; Labs:" GridPane.rowIndex="3" style="-fx-font-weight: bold;" />
                              <Label fx:id="detRxLabLabel" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                           </children>
                        </GridPane>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <Button mnemonicParsing="false" onAction="#handlePrintRecord" prefHeight="35.0" styleClass="btn-success" text="Export Record PDF" />
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
