<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: transparent;" styleClass="main-content-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.odilias.odms.controller.SettingsController">
   <children>
      <TabPane prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="My Profile">
            <content>
               <VBox spacing="20.0" styleClass="card">
                  <children>
                     <Label styleClass="header-label" text="Change Password" />
                     <GridPane hgap="10.0" maxWidth="400.0" vgap="15.0">
                       <columnConstraints>
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
                       </columnConstraints>
                       <rowConstraints>
                         <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                         <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                         <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                       </rowConstraints>
                        <children>
                           <Label text="Current Password:" />
                           <Label text="New Password:" GridPane.rowIndex="1" />
                           <Label text="Confirm New Password:" GridPane.rowIndex="2" />
                           <PasswordField fx:id="currentPwdField" GridPane.columnIndex="1" />
                           <PasswordField fx:id="newPwdField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           <PasswordField fx:id="confirmPwdField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        </children>
                     </GridPane>
                     <Button mnemonicParsing="false" onAction="#handleUpdatePassword" prefHeight="40.0" prefWidth="180.0" styleClass="btn-primary" text="Update Password" />
                  </children>

               </VBox>
            </content>
          </Tab>
          <Tab fx:id="adminTab" text="System Administration">
            <content>
               <VBox spacing="20.0" styleClass="card">
                  <children>
                     <Label styleClass="header-label" text="Database Management" />
                     <HBox spacing="20.0">
                        <children>
                           <Button mnemonicParsing="false" onAction="#handleBackup" prefHeight="50.0" prefWidth="250.0" styleClass="btn-success" text="Generate Full DB Backup (.sql)" />
                           <Button mnemonicParsing="false" onAction="#handleRestore" prefHeight="50.0" prefWidth="250.0" styleClass="btn-primary" style="-fx-background-color: #95a5a6;" text="Restore from File" />
                        </children>
                     </HBox>
                     <Separator />
                     <Label text="System Info" textFill="#7f8c8d" />
                     <GridPane hgap="10.0" vgap="10.0">
                       <columnConstraints>
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                       </columnConstraints>
                       <rowConstraints>
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                       </rowConstraints>
                        <children>
                           <Label text="Software Version:" />
                           <Label text="ODMS v1.0.0 (Stable)" GridPane.columnIndex="1" />
                           <Label text="DB Server:" GridPane.rowIndex="1" />
                           <Label text="MySQL 8.0 / odms_db" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        </children>
                     </GridPane>
                  </children>
               </VBox>
            </content>
          </Tab>
          <Tab fx:id="auditTab" text="Audit Logs">
            <content>
               <VBox spacing="10.0" styleClass="card">
                  <children>
                     <HBox alignment="CENTER_LEFT">
                        <children>
                           <Label styleClass="header-label" text="Recent System Activity" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Button mnemonicParsing="false" onAction="#refreshAuditLogs" styleClass="btn-primary" text="Refresh Activity Log" />
                        </children>
                     </HBox>
                     <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
                       <columns>
                         <TableColumn fx:id="auditTimeCol" prefWidth="180.0" text="Timestamp" />
                         <TableColumn fx:id="auditUserCol" prefWidth="120.0" text="User" />
                         <TableColumn fx:id="auditModuleCol" prefWidth="120.0" text="Module" />
                         <TableColumn fx:id="auditActionCol" prefWidth="400.0" text="Action Performed" />
                       </columns>
                     </TableView>
                  </children>
               </VBox>
            </content>
          </Tab>
          <Tab text="Support &amp; Contact">
            <content>
               <VBox spacing="20.0" styleClass="card">
                  <children>
                     <Label styleClass="header-label" text="Technical Support" />
                     <Label text="For technical assistance, system errors, or feature requests, please contact the developer:" textFill="#7f8c8d" wrapText="true" />
                     <GridPane hgap="10.0" vgap="15.0">
                       <columnConstraints>
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
                       </columnConstraints>
                       <rowConstraints>
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                       </rowConstraints>
                        <children>
                           <Label text="Developer Name:" />
                           <Label text="Veronica Kyalo" style="-fx-font-weight: bold;" GridPane.columnIndex="1" />
                           <Label text="Phone / Voice:" GridPane.rowIndex="1" />
                           <Label text="+254 753 338 454" style="-fx-text-fill: #0071BC; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           <Label text="WhatsApp:" GridPane.rowIndex="2" />
                           <Label text="+254 753 338 454" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        </children>
                     </GridPane>
                     <Separator />
                     <Label text="© 2026 Odilias Dispensary Management System. All rights reserved." textFill="#bdc3c7">
                        <font>
                           <Font size="12.0" />
                        </font>
                     </Label>
                  </children>
               </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>
