<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="450.0" prefWidth="450.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.odilias.odms.controller.AddMedicationController">
   <children>
      <Label text="Add New Medication" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <GridPane hgap="15.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <VBox spacing="5.0" GridPane.columnSpan="2">
               <children>
                  <Label text="Drug Name *" />
                  <TextField fx:id="nameField" promptText="e.g. Paracetamol" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.rowIndex="1">
               <children>
                  <Label text="Batch Number *" />
                  <TextField fx:id="batchField" promptText="e.g. BTC101" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label text="Stock Quantity *" />
                  <TextField fx:id="qtyField" promptText="e.g. 100" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.rowIndex="2">
               <children>
                  <Label text="Expiry Date *" />
                  <DatePicker fx:id="expiryDatePicker" prefWidth="200.0" />
               </children>
            </VBox>
            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Label text="Unit Price (KES) *" />
                  <TextField fx:id="priceField" promptText="e.g. 10.00" />
               </children>
            </VBox>
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Save Medication" />
         </children>
      </HBox>
      <Label fx:id="errorLabel" textFill="#e74c3c" />
   </children>
</VBox>
