<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: transparent;" styleClass="main-content-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.odilias.odms.controller.ReportController">
   <children>
      <Label styleClass="header-label" text="Reports &amp; Analytics" />

      <HBox spacing="20.0">
         <children>
            <!-- Daily Stats -->
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Daily Patients" textFill="#7f8c8d" />
                  <Label fx:id="dailyPatientsLabel" text="0" textFill="#3498db">
                     <font><Font name="System Bold" size="32.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Daily Revenue" textFill="#7f8c8d" />
                  <Label fx:id="dailyRevenueLabel" text="KES 0" textFill="#2ecc71">
                     <font><Font name="System Bold" size="24.0" /></font>
                  </Label>
               </children>
            </VBox>
            
            <Separator orientation="VERTICAL" />

            <!-- Monthly Stats -->
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Monthly Patients" textFill="#7f8c8d" />
                  <Label fx:id="monthlyPatientsLabel" text="0" textFill="#3498db">
                     <font><Font name="System Bold" size="32.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Monthly Revenue" textFill="#7f8c8d" />
                  <Label fx:id="monthlyRevenueLabel" text="KES 0" textFill="#e67e22">
                     <font><Font name="System Bold" size="24.0" /></font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>

      <HBox spacing="20.0">
         <children>
            <!-- Overall Stats -->
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Total Patients" textFill="#7f8c8d" />
                  <Label fx:id="totalPatientsLabel" text="0" textFill="#8e44ad">
                     <font><Font name="System Bold" size="32.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Total Appts" textFill="#7f8c8d" />
                  <Label fx:id="totalApptsLabel" text="0" textFill="#2980b9">
                     <font><Font name="System Bold" size="32.0" /></font>
                  </Label>
               </children>
            </VBox>
            
            <Separator orientation="VERTICAL" />

            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Pending Appts" textFill="#7f8c8d" />
                  <Label fx:id="pendingApptsLabel" text="0" textFill="#e74c3c">
                     <font><Font name="System Bold" size="32.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="130.0" prefWidth="210.0" styleClass="card">
               <children>
                  <Label text="Active Staff" textFill="#7f8c8d" />
                  <Label fx:id="activeStaffLabel" text="0" textFill="#16a085">
                     <font><Font name="System Bold" size="32.0" /></font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>

      <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Export Data &amp; Management Reports" textFill="#2c3e50">
               <font><Font name="System Bold" size="18.0" /></font>
            </Label>
            <Separator />
            <GridPane hgap="25.0" vgap="20.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#generateVisitReport" prefHeight="50.0" styleClass="btn-primary" text="Patient Visit History (CSV)" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#generateFinancialReport" prefHeight="50.0" styleClass="btn-primary" text="Financial Revenue Report (CSV)" GridPane.columnIndex="1" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#generateStaffActivityReport" prefHeight="50.0" styleClass="btn-primary" text="Staff Workload &amp; Directory" GridPane.rowIndex="1" />
               </children>
            </GridPane>
         </children>
      </VBox>
   </children>
</VBox>
